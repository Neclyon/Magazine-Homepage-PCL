9.318-.844.202c-.153-.116-.128-.378-.077-.901l.013-.135c.014-.15.022-.224 0-.292c-.021-.07-.069-.125-.164-.237l-.087-.101c-.335-.392-.503-.588-.445-.776c.059-.189.305-.244.797-.356l.127-.028c.14-.032.21-.048.266-.09c.056-.043.092-.108.164-.237z</sys:String>
    </StackPanel.Resources>

    <StackPanel.Styles>
        <!-- 内联链接：InlineUIContainer 把控件底边贴在基线上，用位移补偿，不参与测量 -->
        <Style Selector="pclcontrols|MyTextButton.inline">
            <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FFACACAC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*" ClipToBounds="True">
                        <ItemsPresenter Name="PART_ItemsPresenter" Grid.Row="0"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                        <Border Name="PART_ContentPanel" Grid.Row="1"
                                CornerRadius="7" Background="Transparent"
                                BorderBrush="{DynamicResource ColorBrush2}" BorderThickness="0">
                            <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              HorizontalContentAlignment="Stretch" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabControl > TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#fff" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Name="templateRoot" Background="Transparent">
                        <Border Name="ContentPanelI"
                                BorderBrush="{DynamicResource ColorBrush2}" BorderThickness="0,0,0,2"
                                Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="7" Height="30" Margin="2,0,2,0" />
                        <TextBlock Name="txt" Text="{TemplateBinding Header}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem:pointerover /template/ TextBlock#txt">
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="TabItem:selected /template/ TextBlock#txt">
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
        </Style>
        <Style Selector="TabItem:disabled /template/ Grid#templateRoot">
            <Setter Property="Opacity" Value="0.56" />
        </Style>

        <!-- 全局文字样式，对应原 styles.xaml 里 TargetType="TextBlock" 那条 -->
        <Style Selector="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        </Style>
    </StackPanel.Styles>

    <StackPanel>
        <pclcontrols:MyHint Margin="0,0,0,6" IsWarn="False" Text="📚 欢迎使用杂志主页 Next" />
        <TabControl FontSize="17">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabItem Header="中文 MCW 特色条目">
                <pclcontrols:MyCard>
                    <StackPanel Margin="20,20,20,20">
                        <Border HorizontalAlignment="Center" BorderThickness="4" VerticalAlignment="Top" BorderBrush="{DynamicResource ColorBrush3}" CornerRadius="7" MaxHeight="140" Height="140">
                            <pclcontrols:MyImage Source="https://zh.minecraft.wiki/images/thumb/FiveStrawBedsLinedUp.png/350px-FiveStrawBedsLinedUp.png?a8afe" Stretch="UniformToFill" CornerRadius="3" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>
                        <Border Margin="0,-20,-1,10" Background="{DynamicResource ColorBrush3}" Width="170" Height="30" CornerRadius="7" BorderThickness="0,0,0,2" BorderBrush="{DynamicResource ColorBrush2}">
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush7}" Width="180" TextWrapping="Wrap" FontSize="18" Text="麦秆床" />
                        </Border>
                        <StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="22" Margin="0,10,0,5" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}">
                                    <TextBlock.Inlines>
                                        <Run FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" Text="麦秆床" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="是一种类似" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%8A" Text="床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="的消耗方块，允许" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B8%BB%E4%B8%96%E7%95%8C" Text="主世界" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="中的玩家在不重置个人" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%87%BA%E7%94%9F%E7%82%B9" Text="出生点" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="的前提下睡觉。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="18" Margin="0,5,0,5" FontWeight="Bold" Foreground="{DynamicResource ColorBrush4}">
                                    <TextBlock.Inlines>
                                        <Run Text="合成 &amp; 生成" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="会生成于" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%9F%E5%BC%83%E8%90%A5%E5%9C%B0" Text="废弃营地" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="的帐篷结构中，也可以在" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%9F%E5%BC%83%E8%90%A5%E5%9C%B0" Text="废弃营地" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%9C%A8%E6%A1%B6" Text="木桶" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="中找到。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="18" Margin="0,5,0,5" FontWeight="Bold" Foreground="{DynamicResource ColorBrush4}">
                                    <TextBlock.Inlines>
                                        <Run Text="特性 &amp; 用途" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Run Text="使用3个" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B9%B2%E8%8D%89%E6%8D%86" Text="干草捆" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="可以合成4个" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Run Text="在" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B8%BB%E4%B8%96%E7%95%8C" Text="主世界" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="中，玩家可以对着" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="按下使用来睡觉。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Run Text="与" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%8A" Text="床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="不同，在睡觉时" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="不会将其设置为玩家的" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%87%BA%E7%94%9F%E7%82%B9" Text="出生点" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="，驯服的" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AB" Text="猫" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="也不会与在" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="上睡觉的玩家互动。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Run Text="在" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B8%BB%E4%B8%96%E7%95%8C" Text="主世界" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="以外的" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%BB%B4%E5%BA%A6" Text="维度" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="中使用" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="时，" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="会被破坏而不掉落自身，不会爆炸或生成火。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="20,0,0,2" Foreground="{DynamicResource ColorBrush1}">
                                        <TextBlock.Inlines>
                                            <Run Text="• " />
                                            <Run Text="玩家主动起" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%8A" Text="床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="或从" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%8A" Text="床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="上醒来后，" />
                                            <Underline>
                                                <InlineUIContainer>
                                                    <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" Text="麦秆床" Classes="inline" />
                                                </InlineUIContainer>
                                            </Underline>
                                            <Run Text="也会被破坏而不掉落自身。" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid VerticalAlignment="Center" Margin="6,10,0,0" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Margin="8,0" Height="28" Fill="{DynamicResource ColorBrush4}" Stretch="Uniform" Data="M4 2H2v12h2V4h10V2zm2 4h12v2H8v10H6zm4 4h12v12H10zm10 10v-8h-8v8z" />
                            <TextBlock HorizontalAlignment="Right" Grid.Column="1" Text="正源 Neclyon" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush4}" />
                        </Grid>
                        <TextBlock Margin="0,2" Grid.Column="1" HorizontalAlignment="Right" Text="最后更新：2026-11-28" FontSize="12" Foreground="{DynamicResource ColorBrush4}" />
                        <pclcontrols:MyIconTextButton Text="WIKI" ToolTip.Tip="在 Minecraft Wiki 上查看该页面" EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BA%A6%E7%A7%86%E5%BA%8A" LogoScale="1.05" Logo="{StaticResource IconPath1}" HorizontalAlignment="Left" Classes="inline" />
                    </StackPanel>
                </pclcontrols:MyCard>
            </TabItem>
            <TabItem Header="新闻专栏">
                <StackPanel>
                    <pclcontrols:MyHint Margin="0,0,0,6" IsWarn="True" Text="⚠️ &quot;最新版本&quot; 板块每日中午 12:00 同步，请注意时效性。" />
                    <pclcontrols:MyCard Title="最新版本" IsSwapped="False" Margin="0,5">
                        <StackPanel Margin="8,38,8,15">
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="最新正式版 点击查看该版本更新日志" Logo="avares://PCL.Launcher/Assets/Images/Blocks/Grass.png" Title="最新正式版 - 26.3" Info="正式版" EventType="打开帮助" EventData="https://mcnews.meloong.com/VersionDetail.json?ver=26.3" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="最新预发布版 点击查看该版本更新日志" Logo="avares://PCL.Launcher/Assets/Images/Blocks/GrassPath.png" Title="最新预发布版 - 26.4-pre-2" Info="预发布版" EventType="打开帮助" EventData="https://mcnews.meloong.com/VersionDetail.json?ver=26.4-pre-2" Type="Clickable" />
                            <Border Height="1.2" Opacity="0.7" Background="{DynamicResource ColorBrush5}" HorizontalAlignment="Stretch" Margin="4,4" />
                            <pclcontrols:MyListItem Margin="10,1" ToolTip.Tip="点击跳转到列表界面" LogoScale="0.9" Logo="https://image.bugjump.net/news/homepage/books.png" Title="历史版本更新日志" Info="点击查看更多更新日志" EventType="打开帮助" EventData="https://mcnews.meloong.com/VersionArchiveList.json" Type="Clickable" />
                        </StackPanel>
                    </pclcontrols:MyCard>
                    <pclcontrols:MyCard Margin="0,5" Title="历史上的今天" IsSwapped="False">
                        <StackPanel Margin="8,38,8,15">
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="http://baike.bdimg.com/cms/rc/r/image/2014-08-31/a1f98622f55984e054a9db8d9f00153f_80_80.jpg" Title="唐朝文学家柳宗元逝世" Info="柳宗元是唐朝文学家。他因出身河东而被称为柳河东、河东先生。他曾因被贬到永州，精神上受到打击，便寄情山水写下千古名诗《江雪》，寄托自己清高而孤傲的情感，抒发政治上的不得意。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E6%9F%B3%E5%AE%97%E5%85%83" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="石敬瑭被辽太宗册封为后晋皇帝" Info="后晋高祖石敬瑭（892年3月30日—942年7月28日），沙陀族，太原人。后唐明宗李嗣源的女婿，五代十国时期后晋开国皇帝（936年11月30日—942年7月28日在位）。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E7%9F%B3%E6%95%AC%E7%91%AD" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="元朝皇帝元泰定帝孛儿只斤·也孙铁木儿出生" Info="孛儿只斤·也孙铁木儿（1293年11月—1328年7月），元朝第六位皇帝，蒙古帝国第十位大汗。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E5%AD%9B%E5%84%BF%E5%8F%AA%E6%96%A4%C2%B7%E4%B9%9F%E5%AD%99%E9%93%81%E6%9C%A8%E5%84%BF" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="清朝皇帝清太宗爱新觉罗·皇太极出生" Info="清太宗爱新觉罗·皇太极（1592年11月28日—1643年9月21日），又译黄台吉、洪太主，生于费阿拉城（今辽宁抚顺新宾县旧老城）。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E7%88%B1%E6%96%B0%E8%A7%89%E7%BD%97%C2%B7%E7%9A%87%E5%A4%AA%E6%9E%81" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="日本江户时代诗人松尾芭蕉逝世" Info="松尾芭蕉（生于寛永21年（1644年），卒于元禄7年10月12日（1694年11月28日）），是江户时代前期的一位俳谐师的署名。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E6%9D%BE%E5%B0%BE%E8%8A%AD%E8%95%89" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="德国哲学家弗里德里希·恩格斯出生" Info="弗里德里希·恩格斯（德语：Friedrich Engels，1820年11月28日－1895年8月5日），德国思想家、哲学家、革命家、教育家、军事理论家，是全世界无产阶级和劳动人民的伟大导师和领袖、马克思主义创始人之一。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E5%BC%97%E9%87%8C%E5%BE%B7%E9%87%8C%E5%B8%8C%C2%B7%E6%81%A9%E6%A0%BC%E6%96%AF" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="俄国钢琴家安东·鲁宾斯坦出生" Info="安东·鲁宾斯坦，俄罗斯犹太裔音乐家。作曲家、钢琴家。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E5%AE%89%E4%B8%9C%C2%B7%E9%B2%81%E5%AE%BE%E6%96%AF%E5%9D%A6" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="辞书编纂家舒新城逝世" Info="舒新城，(1893～1960)学者、出版家。湖南溆浦人。佃农出身。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E8%88%92%E6%96%B0%E5%9F%8E" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="美国科罗拉多州参议员麦克·班尼出生" Info="麦克·班尼（Michael Bennet，1964年－），全名迈克尔·班纳特，美国政治家，毕业于耶鲁法学院，民主党籍联邦参议员。曾任丹佛公立学校系统管理人，被《时代》杂志列为全美十一大教育活动家之一。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E9%BA%A6%E5%85%8B%C2%B7%E7%8F%AD%E5%B0%BC" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="中国革命家和教育家徐特立逝世" Info="徐特立（1877~1968），原名懋恂，字师陶，中国革命家和教育家，湖南善化（今长沙县江背镇）人。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E5%BE%90%E7%89%B9%E7%AB%8B" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="生化学家李卓皓逝世" Info="李卓皓（1913—1987）著名脑垂体内分泌生物化学家。1933年毕业于金陵大学化学系，留校当助教两年。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E6%9D%8E%E5%8D%93%E7%9A%93" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="撒切尔夫人出任新一任英国首相" Info="玛格丽特·希尔达·撒切尔（英语：Margaret Hilda Thatcher，1925年10月13日—2013年4月8日），婚前名玛格丽特·希尔达·罗伯茨（Margaret Hilda Roberts），一般被称为撒切尔夫人。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E7%8E%9B%E6%A0%BC%E4%B8%BD%E7%89%B9%C2%B7%E5%B8%8C%E5%B0%94%E8%BE%BE%C2%B7%E6%92%92%E5%88%87%E5%B0%94" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="香港政府强制收楼清拆九龙寨城" Info="九龙寨城（或称九龙砦城，俗称九龙城寨），是香港殖民地时代位于今九龙城区的一座围城，于1993年被拆卸。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E4%B9%9D%E9%BE%99%E5%AF%A8%E5%9F%8E" Type="Clickable" />
                            <pclcontrols:MyListItem Margin="10,1,10,1" ToolTip.Tip="历史上的今天，点击查看详情" Logo="avares://PCL.Launcher/Assets/Images/Blocks/RedstoneLampOn.png" Title="中国陕西陈家山煤矿发生瓦斯爆炸" Info="瓦斯是古代植物在堆积成煤的初期，纤维素和有机质经厌氧菌的作用分解而成。" EventType="打开网页" EventData="https://baike.baidu.com/item/%E7%93%A6%E6%96%AF/104952" Type="Clickable" />
                        </StackPanel>
                    </pclcontrols:MyCard>
                </StackPanel>
            </TabItem>
        </TabControl>
        <pclcontrols:MyCard Margin="0,10,0,14">
            <Border BorderBrush="{DynamicResource ColorBrush2}" Margin="-0.6" CornerRadius="5" BorderThickness="0,0,0,10">
                <StackPanel>
                    <Grid Margin="26,20,20,2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock FontSize="18" Foreground="{DynamicResource ColorBrush2}">
                                    <TextBlock.Inlines>
                                        <Bold>
                                            <Run Text="PCL2 杂志主页" />
                                        </Bold>
                                    </TextBlock.Inlines>
                                </TextBlock>
                                <pclcontrols:MyIconTextButton ColorType="Highlight" Text="261128:3fdaba5" ToolTip.Tip="当前版本号(非git), 点击复制" EventType="复制文本" EventData="261128:3fdaba5" LogoScale="1.1" Logo="{StaticResource IconPath2}" Classes="inline" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock HorizontalAlignment="Left" Grid.Column="0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush4}">
                                    <TextBlock.Inlines>
                                        <Run Text="主页制作: 黄正源 / Neclyon" />
                                        <LineBreak />
                                        <Run Text="更新时间: 每日中午 12:00（GitHub Actions）" />
                                        <LineBreak />
                                        <Run Text="内容取自" />
                                        <Underline>
                                            <InlineUIContainer>
                                                <pclcontrols:MyTextButton EventType="打开网页" EventData="https://zh.minecraft.wiki" Text="中文 Minecraft Wiki" Classes="inline" />
                                            </InlineUIContainer>
                                        </Underline>
                                        <Run Text="中“本周页面”板块以及 " />
                                        <Underline>
                                            <InlineUIContainer>
                                                <pclcontrols:MyTextButton EventType="打开网页" EventData="https://baike.baidu.com" Text="百度百科" Classes="inline" />
                                            </InlineUIContainer>
                                        </Underline>
                                        <Run Text="。
                            " />
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-8,0,0,10">
                                <pclcontrols:MyIconTextButton HorizontalAlignment="Left" Text="GitHub" ToolTip.Tip="前往杂志主页 GitHub 页面" EventType="打开网页" EventData="https://github.com/Neclyon/Magazine-Homepage-PCL" LogoScale="1" Logo="{StaticResource IconPath3}" Classes="inline" />
                                <pclcontrols:MyIconTextButton Text="CC BY-NC-SA 3.0" ToolTip.Tip="无特殊声明本主页文字内容使用该授权协议" EventType="打开网页" EventData="https://creativecommons.org/licenses/by-nc-sa/3.0/" LogoScale="1" Logo="{StaticResource IconPath4}" Classes="inline" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <pclcontrols:MyIconTextButton HorizontalAlignment="Left" Text="反馈" ToolTip.Tip="反馈主页问题" EventType="打开网页" EventData="https://github.com/Neclyon/Magazine-Homepage-PCL/issues/new" LogoScale="1" Logo="{StaticResource IconPath5}" Classes="inline" />
                            <pclcontrols:MyIconTextButton HorizontalAlignment="Left" Text="刷新" ToolTip.Tip="刷新主页" EventType="刷新主页" LogoScale="0.9" Logo="{StaticResource IconPath6}" Classes="inline" />
                            <pclcontrols:MyIconTextButton HorizontalAlignment="Left" Text="鸣谢" ToolTip.Tip="鸣谢人员名单及其联系方式" EventType="弹出窗口" EventData="鸣谢|一些对主页开发有帮助的人：
土星仙鹤                                     @ QQ(2480379448) 主页初版的首个测试者！
Essdak1986                               @ QQ(1837750594) 带我接触了自定义主页,没有他我可能到现在还不知道主页是什么！
最亮的信标                                  @ Github(Nattiden) 提供主页模板,本主页使用他的NewsHomepage和HomepageBuilder为基础开发！
Mfn233                                       @ Github(Mfn233) 为主页提供最开始的技术支持和鼓励！
主页群的各位                               @ QQ群(828081791等) 为主页的开发提供持续的精神力量。
凌云                                            @ Github(MoYuan-CN) （曾经）提供挂载主页的OSS，并且对主页生成器重构做了贡献。
排列没啥顺序，个个我都非常非常非常谢谢你们！" LogoScale="0.9" Logo="{StaticResource IconPath7}" Classes="inline" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </pclcontrols:MyCard>
    </StackPanel>
</StackPanel>
