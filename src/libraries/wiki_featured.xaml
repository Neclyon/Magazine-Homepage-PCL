<!-- 中文 Minecraft Wiki 特色条目，内容由 modules/wiki.py 提供 -->
<local:MyCard>
    <StackPanel Style="{StaticResource ContentStack}">
        <Border Style="{StaticResource HeadImageBorder}">
            <Border.Background>
                <ImageBrush ImageSource="${$Wiki|image}" Stretch="UniformToFill" />
            </Border.Background>
            <Image Source="${$Wiki|image}" Opacity="0" Stretch="Fill"/>
        </Border>
        <Border Style="{StaticResource TitleBorder}">
            <TextBlock Style="{StaticResource TitleBlock}" Text="${$Wiki|topic}" />
        </Border>
        <FlowDocumentScrollViewer>
            <FlowDocument>
                <Paragraph Style="{StaticResource H2}">
                    <Run FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" Text="${$Wiki|topic}"/>
                </Paragraph>
                <List>
                    ${$Wiki|intro}
                </List>
                <Paragraph Style="{StaticResource H3}">合成 &amp; 生成</Paragraph>
                <List>
                    ${$Wiki|intro_2}
                </List>
                <Paragraph Style="{StaticResource H3}">特性 &amp; 用途</Paragraph>
                <List>
                    ${$Wiki|body}
                </List>
            </FlowDocument>
        </FlowDocumentScrollViewer>
        <Grid VerticalAlignment="Center" Margin="6,10,0,0" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="45"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Margin="8,0" Height="28" Fill="{DynamicResource ColorBrush4}"
                Stretch="Uniform"
                Data="${$Icon|share}"/>
            <TextBlock HorizontalAlignment="Right" Grid.Column="1" Text="正源 Neclyon" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush4}"/>
        </Grid>
        <TextBlock Margin="0,2" Grid.Column="1" HorizontalAlignment="Right" Text="${$UpdatedAt}" FontSize="12" Foreground="{DynamicResource ColorBrush4}"/>
        <local:MyIconTextButton Text="WIKI" ToolTip="在 Minecraft Wiki 上查看该页面" EventType="打开网页"
            EventData="${$Wiki|link}" LogoScale="1.05" Logo="${$Icon|wiki}" HorizontalAlignment="Left"/>
    </StackPanel>
</local:MyCard>
